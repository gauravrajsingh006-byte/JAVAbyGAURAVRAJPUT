public class squareprinting {
public static void main(String[] args) {
    int n = 5; // Size of the square
    for (int i = 0; i  < n; i++) {
        for (int j = 0; j < n; j++) {
            System.out .print(" *");
        }
        System.out.println(); // Move to the next line after each row
    }
}    
}
